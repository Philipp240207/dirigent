{
  "partner_id": "electrician_schmitz",
  "role": "electrician",
  "category": "repairs",
  "mode": "deliver",
  "detect": {
    "events": [
      "water_leak_near_electrics",
      "power_outage"
    ],
    "conditions": "photo assessment electrics = true"
  },
  "handover": {
    "required": [
      "address",
      "unit_id",
      "caretaker_contact",
      "damage_photo",
      "damage_assessment",
      "tenant_availability"
    ],
    "never": [
      "rent_arrears_eur",
      "key_safe"
    ]
  },
  "conversation": {
    "channel": "browser",
    "agent": "partner_call",
    "language": "de",
    "goal": "confirm the earliest slot to check the ceiling lamp and wiring, ideally together with the plumber"
  },
  "close_loop": {
    "result_fields": [
      "slot",
      "cost_eur",
      "work_description"
    ],
    "write_to_property": "maintenance_log",
    "notify": [
      "tenant",
      "owner"
    ],
    "approval_over_eur": 500
  },
  "cost_rule": "voice only if urgent, language barrier or new resident without portal; otherwise message"
}